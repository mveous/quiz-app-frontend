# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# --- Database ---
POSTGRES_USER=mveousquiz
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=mveousquiz
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://mveousquiz:change-me-locally@localhost:5433/mveousquiz

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=local-dev-secret-1783732080-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Email (SMTP) ---
# Fill these in with your own provider to send real emails (e.g. Gmail App Password).
# Left blank: reset links are logged to the backend console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@mveousquiz.local
SMTP_FROM_NAME=MveousQuiz

# --- AI Provider (self-hosted, no third-party API key or app required) ---
AI_PROVIDER=shali
SHALI_GENERATION_MODEL_PATH=models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
SHALI_EMBEDDING_MODEL_PATH=models/nomic-embed-text-v1.5.Q4_K_M.gguf
SHALI_N_GPU_LAYERS=-1
SHALI_N_CTX=8192
AI_EMBEDDING_DIM=768

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_GENERATION_PER_MINUTE=5
